# Normalise line endings across platforms.

# Detect text automatically and use native checkout endings.
* text=auto

# Windows shell scripts need CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# POSIX shell scripts need LF.
*.sh   text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.mp3  binary
*.ogg  binary
*.wav  binary
*.exe  binary
*.nnue binary
*.bin  binary
*.zip  binary
