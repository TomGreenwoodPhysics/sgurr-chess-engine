# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# C++ build outputs
*.exe
*.o
*.obj
*.dll
*.a
*.lib

# PGO profiles regenerated by BUILD.md
pgo/
pgo2/
*.profraw
*.profdata

# Generated analysis and match output
analysis_games/
*.jsonl
*.csv
*.pgn
*_file_list.txt

# Stockfish binary / local engines
stockfish/

# NNUE networks and training data
# Manifests and training logs remain tracked as provenance records.
*.nnue
*.bin
data/**/*.zip
engines/

# Keep the shipped net so clones can reproduce the release benchmark.
# Ignore `nets/*` rather than the directory so the exceptions still match.
nets/*
!nets/gen8.nnue
!nets/README.md

# Benchmark downloads and run output
benchmarks/engines/
benchmarks/tools/
benchmarks/games/
benchmarks/config.json
benchmarks/ratings.csv

# Per-run scratch files
runs/
_backups/

# fastchess writes this run state in its current directory.
config.json

# Test runner output
test-results/
playwright-report/
node_modules/

# Local editor configuration
.vscode/

# Editor and OS cruft
.DS_Store
Thumbs.db
desktop.ini
.tmp/

# Local web demo server logs
*.log
