# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# C++ build outputs
*.exe
*.o
*.obj
*.dll
*.a
*.lib

# PGO profile data (a build artefact, regenerated by the recipe in BUILD.md)
pgo/
pgo2/
*.profraw
*.profdata

# Generated analysis and match output
analysis_games/
*.jsonl
*.csv
*.pgn
*_file_list.txt

# Stockfish binary / local engines
stockfish/

# Trained networks and NNUE training data. The manifests and training logs
# under data/ ARE tracked -- they are the provenance record. Only the bulk
# artefacts they describe are excluded.
*.nnue
*.bin
data/**/*.zip
engines/

# ...with one deliberate exception: the shipped net. Without it a clone falls
# back to the hand-crafted eval and cannot reproduce the release bench
# fingerprint at all. 578 KB is worth that. Note this must be `nets/*` and not
# `nets/` -- git does not descend into an excluded DIRECTORY, so a negation
# inside one never fires. The negation also has to come after `*.nnue`, since
# the last matching pattern wins.
nets/*
!nets/gen8.nnue
!nets/README.md

# Benchmark working directories: downloaded opponents, tournament binaries,
# and the PGN/rating output of a run. benchmarks/ledger.md, pool.json and
# anchors.txt are tracked -- those are the record, not the scratch.
benchmarks/engines/
benchmarks/tools/
benchmarks/games/
benchmarks/config.json
benchmarks/ratings.csv

# Per-run scratch: logs, partial gauntlets, resumable pipeline state
runs/
_backups/

# fastchess run state: rewritten in place with live match stats on every run,
# so it is scratch output rather than source. fastchess drops config.json in
# whatever directory it is invoked from, so match the NAME rather than listing
# paths -- naming paths is how a root-level one slipped through once.
config.json

# Test-runner output. Playwright writes test-results/ and playwright-report/
# next to wherever it is invoked, which is not always web/.
test-results/
playwright-report/
node_modules/

# Local tool configuration: machine-specific, contains absolute paths
.claude/settings.local.json
.vscode/

# Editor and OS cruft
.DS_Store
Thumbs.db
desktop.ini
.tmp/

# Local web demo server logs
*.log
